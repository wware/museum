#!/bin/bash
# Pre-commit hook: recompile TypeScript when src/*.ts changes and stage the output.
# Compiled JS in docs/js/ is committed (the Docker image has no Node.js).

if git diff --cached --name-only | grep -q '^src/.*\.ts$'; then
    echo "TypeScript files changed, recompiling..."

    if ! command -v npm &> /dev/null; then
        echo "Error: npm not found. Run 'npm run build' manually before committing."
        exit 1
    fi

    if [ ! -d "node_modules" ]; then
        echo "Error: node_modules not found. Run 'npm install' first."
        exit 1
    fi

    if ! npm run build; then
        echo "Error: TypeScript compilation failed. Fix the errors and commit again."
        exit 1
    fi

    # Source maps (*.js.map) are git-ignored, so only stage the JS itself
    git add docs/js/*.js

    echo "TypeScript compiled and docs/js/*.js staged."
fi

exit 0
